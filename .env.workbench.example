# Reuse the existing backend Groq key. Never put this key in the React app.
GROQ_API_KEY=
# Must support strict JSON-schema output; see Groq's structured-output documentation.
GROQ_EXTRACTION_MODEL=openai/gpt-oss-120b
# Optional shared access key for this single-user/local workbench, not a Groq key.
WORKBENCH_API_KEY=
WORKBENCH_DATA_DIR=./workbench_data
