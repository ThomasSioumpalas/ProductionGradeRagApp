FROM python:3.12-slim
WORKDIR /app
COPY requirements-workbench.lock .
RUN pip install --no-cache-dir -r requirements-workbench.lock
COPY financial_workbench ./financial_workbench
ENV WORKBENCH_DATA_DIR=/data
EXPOSE 8001
CMD ["python", "-m", "uvicorn", "financial_workbench.api:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]
